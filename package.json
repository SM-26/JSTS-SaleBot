{
  "name": "sales-bot",
  "version": "3.4.1",
  "packageManager": "pnpm@11.13.1",
  "main": "dist/bot.js",
  "description": "JSTS-SaleBot implementation",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot.js",
    "dev": "ts-node src/bot.ts",
    "check-locals": "ts-node src/tests/checkLocals.ts",
    "check-config": "ts-node src/tests/configSchema.check.ts",
    "check-classifier": "ts-node src/tests/checkClassifier.ts",
    "check-catchup": "ts-node src/tests/checkCatchup.ts",
    "catchup": "ts-node scripts/catchup.ts",
    "check-claim": "ts-node src/tests/checkModerationClaim.ts",
    "check-polling": "ts-node src/tests/checkPollingErrors.ts",
    "check-callbacks": "ts-node src/tests/checkCallbackData.ts",
    "check-cards": "ts-node src/tests/checkListingCards.ts",
    "check-platform": "ts-node src/tests/checkPlatform.ts",
    "check-store": "ts-node src/tests/checkSessionStore.ts",
    "check-routes": "ts-node src/tests/checkRoutes.ts",
    "check-flows": "ts-node src/tests/checkFlows.ts",
    "check-market": "ts-node src/tests/checkMarket.ts",
    "check-buyer": "ts-node src/tests/checkBuyerMatches.ts",
    "check-dump": "ts-node src/tests/checkProdDump.ts",
    "check-rich": "ts-node src/tests/checkRichMessages.ts",
    "check-tiers": "ts-node src/tests/checkTiers.ts",
    "check-docs": "ts-node src/tests/checkDocs.ts",
    "lint": "eslint .",
    "test": "ts-node src/tests/runAll.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SM-26/JSTS-SaleBot.git"
  },
  "bugs": {
    "url": "https://github.com/SM-26/JSTS-SaleBot/issues"
  },
  "homepage": "https://github.com/SM-26/JSTS-SaleBot/wiki",
  "author": "SM26",
  "license": "ISC",
  "auditLevel": "low",
  "dependencies": {
    "dotenv": "^18.0.9",
    "mongoose": "^9.12.0",
    "node-telegram-bot-api": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
